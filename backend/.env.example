# Copy to .env to override defaults.

# Database. Default (unset) uses a local SQLite file — zero setup.
# For PostgreSQL (production-style), install psycopg and use e.g.:
# DATABASE_URL=postgresql+psycopg://smarthealth:smarthealth@localhost:5432/smarthealth
# DATABASE_URL=

# District name used across the demo data and district view.
# DISTRICT_NAME=Bareilly

# --- Google AI (Gemini) ------------------------------------------------------
# Free key from https://aistudio.google.com/apikey (no billing required).
# When set, natural-language SMS parsing, AI supervisor briefings, and the
# "Ask the district" assistant use live Gemini. When unset, they fall back to
# deterministic templates so the app still runs.
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash
