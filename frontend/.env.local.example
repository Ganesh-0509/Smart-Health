# Base URL of the Smart Health backend API.
# The frontend calls ${NEXT_PUBLIC_API_URL}/api/...
# If the backend is unreachable, the app automatically falls back to bundled mock data.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Firebase Authentication (Google sign-in) — OPTIONAL ---
# These are OPTIONAL. If you leave them unset, the app runs in demo mode:
# "Sign in with Google" signs in a local mock "Demo Supervisor" user and no
# Firebase SDK is initialised. Set all four to enable real Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Embed API (Facility map page) — OPTIONAL ---
# Uses the Maps *Embed* API, which is free with no usage cap (no billing).
# Enable "Maps Embed API" in Google Cloud Console, create an API key, and
# restrict it to your domain (HTTP referrers). If unset, the Facility map page
# still works — it shows keyless "Open in Google Maps" links instead of an
# embedded live map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
